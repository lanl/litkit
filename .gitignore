__pycache__/
*.py[cod]
.DS_Store
dist/
build/
!src/litkit/build/
*.egg-info/
.venv/
.pytest_cache/
build_*.log
sqfs/
wheels/

# HF models and runtime artifacts
# Ignore workspace contents except manifest and test files
workspace/*

# Track manifest files (tar.gz file lists)
!workspace/*.manifest

# Track test files (prompts and expected responses)
!workspace/question.txt
!workspace/answer.md

# Track directory itself
!workspace/.gitkeep

# Explicitly ignore large directories
workspace/emb_segments/
workspace/indices/
workspace/sqlite/
workspace/hf_cache/
workspace/pmcoa_links/
workspace/.ch-mnt/
workspace/tar_files/

# SLURM logs (all patterns)
litkit-build.*.out
litkit-build.*.err
litkit_multi_*.out
litkit_multi_*.err
*.out
*.err

# Generated documentation
#*.pdf

# JOSS paper (kept locally, not tracked)
paper/
